-- Items Highlight Setup
local activeHighlights = {}
local isHighlightActive = false

local function clearHighlights()
    for obj, highlight in pairs(activeHighlights) do
        if highlight then
            highlight:Destroy()
        end
    end
    activeHighlights = {}
end

local function updateHighlights()
    clearHighlights()
    
    local folder = workspace:FindFirstChild("GameTriggers")
    folder = folder and folder:FindFirstChild("Items")
    if not folder then return end

    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("BasePart") and not activeHighlights[obj] then
            local highlight = Instance.new("Highlight")
            highlight.Adornee = obj
            highlight.FillColor = Color3.fromRGB(0, 170, 255)
            highlight.Parent = obj
            highlight.OutlineTransparency = 1 
            activeHighlights[obj] = highlight
        end
    end
end

Tabs.visuel:AddToggle("ItemHighlights", {
    Title = "Item Highlights",
    Default = false,
    Callback = function(state)
        isHighlightActive = state
        
        if state then
            updateHighlights()
            task.spawn(function()
                while isHighlightActive do
                    task.wait(3)
                    if isHighlightActive then
                        updateHighlights()
                    end
                end
            end)
        else
            clearHighlights()
        end
    end
})

