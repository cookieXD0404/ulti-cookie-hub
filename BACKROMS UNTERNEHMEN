local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local speedActive = false
local customSpeed = 16
local speedConnection

local function updateSpeedConnection()
    if (speedActive and tonumber(customSpeed) and customSpeed > 16) then
        if not speedConnection then
            speedConnection = RunService.RenderStepped:Connect(function(dt)
                local speedVal = tonumber(customSpeed) or 16
                if not speedActive or speedVal <= 16 then return end
                local char = player.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                if root and humanoid and humanoid.MoveDirection.Magnitude > 0 then
                    local moveDir = humanoid.MoveDirection.Unit
                    root.CFrame = root.CFrame + (moveDir * (speedVal - 16) * dt)
                end
            end)
        end
    else
        if speedConnection then
            speedConnection:Disconnect()
            speedConnection = nil
        end
    end
end

Tabs.lp:AddToggle("SpeedToggle", {
    Title = "Vector Speed",
    Default = false,
    Callback = function(state)
        speedActive = state
        updateSpeedConnection()
    end
})

Tabs.lp:AddSlider("SpeedSlider", {
    Title = "Speed Stärke",
    Default = 16,
    Min = 16,
    Max = 100,
    Rounding = 1,
    Callback = function(value)
        customSpeed = tonumber(value) or 16
        updateSpeedConnection()
    end
})



local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local isNoclipActive = false
local originalCollisions = {}
local noclipConnection

Tabs.lp:AddToggle("NoclipToggle", {
    Title = "Noclip",
    Default = false,
    Callback = function(state)
        isNoclipActive = state
        
        if state then
            originalCollisions = {}
            noclipConnection = RunService.Stepped:Connect(function()
                local character = player.Character
                if not character then return end
                
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if originalCollisions[part] == nil then
                            originalCollisions[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end)
        else
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            
            for part, originalCanCollide in pairs(originalCollisions) do
                if part and part.Parent then
                    part.CanCollide = originalCanCollide
                end
            end
            originalCollisions = {}
        end
    end
})








